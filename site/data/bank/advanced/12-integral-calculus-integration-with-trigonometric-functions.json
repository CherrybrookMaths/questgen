{"v":3,"topic":"sub:12|Integral calculus|Integration with trigonometric functions","q":{"214":{"stem":null,"options":[],"opt_table":null,"layout":null,"figures":[],"parts":[{"id":319,"latex":"Evaluate $\\displaystyle\\int_0^{\\frac{\\pi}{4}}\\sec^2 x\\,dx$.","needs_review":0,"c17":{"code":"MA-C4.1","conf":0.85},"note":null,"can_use":[]}],"solutions":[{"id":278,"part_id":null,"source":"extracted","latex":"$$\\begin{aligned} &\\int_0^{\\frac{\\pi}{4}} \\sec^2 x\\,dx \\\\ &= \\Big[\\tan x\\Big]_0^{\\frac{\\pi}{4}} \\\\ &= \\Big[\\tan\\dfrac{\\pi}{4} - \\tan 0\\Big] \\\\ &= 1 \\end{aligned}$$","criteria":[[2,"Correct answer"],[1,"Finds the anti-derivative of $\\sec^2 x$, or equivalent merit"]],"meta":{"top_criterion_original":"Provides the correct solution"}}]},"331":{"stem":null,"options":[],"opt_table":null,"layout":null,"figures":[],"parts":[{"id":481,"latex":"Evaluate $\\displaystyle\\int_0^{\\frac{\\pi}{8}} \\sec^2 2x\\,dx$","needs_review":1,"c17":{"code":"MA-C4.1","conf":0.8},"note":null,"can_use":[]}],"solutions":[{"id":452,"part_id":481,"source":"generated","latex":"$$\\begin{aligned} \\int_0^{\\frac{\\pi}{8}}\\sec^2 2x\\,dx &= \\left[\\dfrac{1}{2}\\tan 2x\\right]_0^{\\frac{\\pi}{8}} \\\\ &= \\dfrac{1}{2}\\tan\\dfrac{\\pi}{4} - \\dfrac{1}{2}\\tan 0 \\\\ &= \\dfrac{1}{2}(1) - 0 \\\\ &= \\dfrac{1}{2} \\end{aligned}$$","criteria":[[2,"Correct answer"],[1,"Finds the primitive $\\dfrac{1}{2}\\tan 2x$, or equivalent merit"]],"meta":{"confidence":0.95,"check":"passed","top_criterion_original":"Value $\\dfrac{1}{2}$","rubric_note":"Rewritten top-down from a one-mark-per-step rubric (owner rule, 11 Nov)."}}]},"311":{"stem":null,"options":[],"opt_table":null,"layout":null,"figures":[],"parts":[{"id":483,"latex":"","needs_review":1,"c17":null,"free":[],"note":null},{"id":484,"latex":"Differentiate $\\cos 3x^3$","needs_review":1,"c17":{"code":"MA-C2.1","conf":0.8},"note":null,"can_use":[]},{"id":485,"latex":"Hence find $\\displaystyle \\int x^2\\sin 3x^3\\,dx$","needs_review":1,"c17":{"code":"MA-C4.1","conf":0.8},"note":null,"can_use":[]}],"solutions":[{"id":454,"part_id":484,"source":"generated","latex":"Let $u = 3x^3$, so $\\dfrac{du}{dx} = 9x^2$. By the chain rule,\n$$\\begin{aligned} \\dfrac{d}{dx}\\cos 3x^3 &= -\\sin(3x^3)\\cdot 9x^2 \\\\ &= -9x^2\\sin 3x^3 \\end{aligned}$$","criteria":[[2,"Correct answer"],[1,"Finds the inner derivative $9x^2$, or equivalent merit"]],"meta":{"confidence":0.95,"check":"passed","top_criterion_original":"$-9x^2\\sin 3x^3$","rubric_note":"Rewritten top-down from a one-mark-per-step rubric (owner rule, 11 Nov)."}},{"id":455,"part_id":485,"source":"generated","latex":"From (i),\n$$\\dfrac{d}{dx}\\cos 3x^3 = -9x^2\\sin 3x^3$$\nso\n$$\\begin{aligned} \\int x^2\\sin 3x^3\\,dx &= -\\dfrac{1}{9}\\int -9x^2\\sin 3x^3\\,dx \\\\ &= -\\dfrac{1}{9}\\cos 3x^3 + C \\end{aligned}$$","criteria":[[2,"Correct answer"],[1,"Uses part (i) and adjusts the constant factor $-\\dfrac{1}{9}$, or equivalent merit"]],"meta":{"confidence":0.95,"check":"passed","top_criterion_original":"$-\\dfrac{1}{9}\\cos 3x^3 + C$","rubric_note":"Rewritten top-down from a one-mark-per-step rubric (owner rule, 11 Nov)."}}]},"8":{"stem":null,"options":[{"label":"A","latex":"$\\cot x+c$","is_correct":0,"key_source":"extracted","fig":null},{"label":"B","latex":"$\\tan x+c$","is_correct":1,"key_source":"extracted","fig":null},{"label":"C","latex":"$x-\\ln(\\cos x)+c$","is_correct":0,"key_source":"extracted","fig":null},{"label":"D","latex":"$x+\\ln(\\sin x)+c$","is_correct":0,"key_source":"extracted","fig":null}],"opt_table":null,"layout":"text","figures":[],"parts":[{"id":8,"latex":"Which of the following is an expression for $\\displaystyle\\int \\tan x(\\cot x+\\tan x)\\,dx$ ?","needs_review":1,"c17":{"code":"MA-C4.1","conf":0.8},"note":null,"can_use":[]}],"solutions":[{"id":8,"part_id":null,"source":"extracted","latex":"$$\\begin{aligned}\\int\\tan x(\\cot x+\\tan x)\\,dx&=\\int(1+\\tan^2 x)\\,dx\\\\ &=\\int\\sec^2 x\\,dx\\\\ &=\\tan x+c\\end{aligned}$$","criteria":[[1,"Correct answer"]],"meta":{}}]},"817":{"stem":null,"options":[],"opt_table":null,"layout":null,"figures":[],"parts":[{"id":1337,"latex":"Evaluate $\\displaystyle\\int_0^{\\frac{\\pi}{4}} \\cos 2x\\,dx$.","needs_review":0,"c17":{"code":"MA-C4.2","conf":0.85},"note":null,"can_use":[]}],"solutions":[{"id":1124,"part_id":null,"source":"extracted","latex":"$$\\begin{aligned} \\int_0^{\\frac{\\pi}{4}} \\cos 2x\\,dx &= \\left[\\dfrac{1}{2}\\sin 2x\\right]_0^{\\frac{\\pi}{4}} \\\\ &= \\dfrac{1}{2}\\sin\\left(2 \\times \\dfrac{\\pi}{4}\\right) - \\dfrac{1}{2}\\sin 0 \\\\ &= \\dfrac{1}{2}\\sin\\dfrac{\\pi}{2} - 0 \\\\ &= \\dfrac{1}{2} \\times 1 \\\\ &= \\dfrac{1}{2} \\end{aligned}$$","criteria":[[2,"Correct answer"],[1,"Correct integral, or equivalent merit"]],"meta":{"concern":"transcribed from handwritten solutions copy (images, no text layer)","top_criterion_original":"Correctly integrates, correctly substitutes in and calculates the answer"}}]},"931":{"stem":null,"options":[],"opt_table":null,"layout":null,"figures":[],"parts":[{"id":1518,"latex":"Find $\\displaystyle\\int\\sec^2 2x\\,dx$","needs_review":0,"c17":{"code":"MA-C4.1","conf":0.8},"note":null,"can_use":[]}],"solutions":[{"id":1304,"part_id":null,"source":"extracted","latex":"$$\\int\\sec^2 2x\\,dx=\\dfrac{1}{2}\\tan 2x+c$$","criteria":[[1,"Correct answer"]],"meta":{"top_criterion_original":"Correct integral + c"}}]},"1446":{"stem":null,"options":[],"opt_table":null,"layout":null,"figures":[],"parts":[{"id":2368,"latex":"Find the derivative of the function $y=\\tan(x^2)$.","needs_review":1,"c17":{"code":"MA-C2.1","conf":0.9},"note":null,"can_use":[]},{"id":2369,"latex":"By using an appropriate trigonometric identity, find $\\displaystyle\\int x\\tan^2(x^2)\\,dx$.","needs_review":1,"c17":{"code":"MA-C4.1","conf":0.75},"note":null,"can_use":["Integration using a given derivative"]}],"solutions":[{"id":2118,"part_id":2368,"source":"extracted","latex":"Using the chain rule:\n$$\\begin{aligned} \\dfrac{dy}{dx}&=\\sec^2(x^2)\\times\\dfrac{d}{dx}(x^2)\\\\ &=2x\\sec^2(x^2) \\end{aligned}$$","criteria":[[1,"Correct answer"]],"meta":{"top_criterion_original":"Provides correct solution"}},{"id":2119,"part_id":2369,"source":"extracted","latex":"Using the Pythagorean identity $\\tan^2\\theta=\\sec^2\\theta-1$:\n$$\\begin{aligned} \\int x\\tan^2(x^2)\\,dx&=\\int x\\left(\\sec^2(x^2)-1\\right)dx\\\\ &=\\dfrac{1}{2}\\int 2x\\left(\\sec^2(x^2)-1\\right)dx\\\\ &=\\dfrac{1}{2}\\int\\left(2x\\sec^2(x^2)-2x\\right)dx\\\\ &=\\dfrac{1}{2}\\left(\\tan(x^2)-x^2\\right)+C &&(\\text{using part (a)}) \\end{aligned}$$","criteria":[[2,"Correct answer"],[1,"Expresses integrand with appropriate Pythagorean identity, or equivalent merit"]],"meta":{"top_criterion_original":"Provides correct solution"}}]},"1050":{"stem":null,"options":[],"opt_table":null,"layout":null,"figures":[],"parts":[{"id":1704,"latex":"Find the exact value of $\\displaystyle\\int_{\\frac{1}{3}}^{\\frac{1}{2}}\\sec^2\\left(\\dfrac{\\pi x}{2}\\right)dx$.","needs_review":0,"c17":{"code":"MA-C4.2","conf":0.85},"note":null,"can_use":[]}],"solutions":[{"id":1489,"part_id":null,"source":"extracted","latex":"Using the reference sheet:\n$$\\int f'(x)\\sec^2f(x)\\,dx=\\tan f(x)+c$$\n$$\\begin{aligned}\\int_{\\frac{1}{3}}^{\\frac{1}{2}}\\sec^2\\left(\\dfrac{\\pi x}{2}\\right)dx&=\\dfrac{2}{\\pi}\\int_{\\frac{1}{3}}^{\\frac{1}{2}}\\dfrac{\\pi}{2}\\sec^2\\left(\\dfrac{\\pi x}{2}\\right)dx\\\\&=\\dfrac{2}{\\pi}\\left[\\tan\\left(\\dfrac{\\pi x}{2}\\right)\\right]_{\\frac{1}{3}}^{\\frac{1}{2}}\\\\&=\\dfrac{2}{\\pi}\\left[\\tan\\left(\\dfrac{\\pi}{4}\\right)-\\tan\\left(\\dfrac{\\pi}{6}\\right)\\right]\\\\&=\\dfrac{2}{\\pi}\\left[1-\\dfrac{1}{\\sqrt{3}}\\right]\\\\&=\\dfrac{6-2\\sqrt{3}}{3\\pi}\\\\&=\\dfrac{2(3-\\sqrt{3})}{3\\pi}\\end{aligned}$$","criteria":[[2,"Correct answer"],[1,"Correct primitive $\\dfrac{2}{\\pi}\\left[\\tan\\left(\\dfrac{\\pi x}{2}\\right)\\right]$, or equivalent merit"]],"meta":{"corrected":"Corrected from source: the last line factorised 6 − 2√3 as 2(2 − √3); it is 2(3 − √3), so the answer is 2(3 − √3)/(3π) = (6 − 2√3)/(3π)."}}]},"1089":{"stem":null,"options":[],"opt_table":null,"layout":null,"figures":[],"parts":[{"id":1760,"latex":"Evaluate: $\\displaystyle\\int 2\\tan^2 x\\,dx$","needs_review":0,"c17":{"code":"MA-C4.1","conf":0.85},"note":null,"can_use":[]}],"solutions":[{"id":1545,"part_id":null,"source":"extracted","latex":"Using $\\tan^2x=\\sec^2x-1$:\n$$\\begin{aligned}\\int 2\\tan^2x\\,dx&=2\\int\\left(\\sec^2x-1\\right)dx\\\\&=2\\big[\\tan x-x\\big]+C\\\\&=2\\tan x-2x+C\\end{aligned}$$","criteria":[[1,"Correct answer"]],"meta":{"top_criterion_original":"correct answer (uses $\\tan^2x=\\sec^2x-1$)"}}]},"1131":{"stem":"Find","options":[],"opt_table":null,"layout":null,"figures":[],"parts":[{"id":1821,"latex":"$\\displaystyle\\int(4x+7)^5\\,dx$","needs_review":0,"c17":{"code":"MA-C4.1","conf":0.95},"note":null,"can_use":[]},{"id":1822,"latex":"$\\displaystyle\\int\\dfrac{2x}{3x^2+1}\\,dx$","needs_review":0,"c17":{"code":"MA-C4.1","conf":0.95},"note":null,"can_use":[]},{"id":1823,"latex":"$\\displaystyle\\int 2+2\\tan^2 x\\,dx$","needs_review":0,"c17":{"code":"MA-C4.1","conf":0.85},"note":null,"can_use":[]}],"solutions":[{"id":1606,"part_id":1821,"source":"extracted","latex":"Using $\\displaystyle\\int(ax+b)^n\\,dx=\\dfrac{(ax+b)^{n+1}}{a(n+1)}+C$:\n$$\\int(4x+7)^5\\,dx=\\dfrac{1}{24}(4x+7)^6+C$$","criteria":[[1,"Correct answer"]],"meta":{"top_criterion_original":"correct primitive"}},{"id":1607,"part_id":1822,"source":"extracted","latex":"The numerator is a multiple of the derivative of $3x^2+1$, which is $6x$:\n$$\\begin{aligned}\\int\\dfrac{2x}{3x^2+1}\\,dx&=\\dfrac{1}{3}\\int\\dfrac{6x}{3x^2+1}\\,dx\\\\&=\\dfrac{1}{3}\\ln|3x^2+1|+C\\end{aligned}$$","criteria":[[2,"Correct answer"]],"meta":{"top_criterion_original":"correct primitive (no breakdown given)"}},{"id":1608,"part_id":1823,"source":"extracted","latex":"Using $1+\\tan^2x=\\sec^2x$:\n$$\\begin{aligned}\\int\\left(2+2\\tan^2 x\\right)dx&=2\\int\\left(1+\\tan^2 x\\right)dx\\\\&=2\\int\\sec^2 x\\,dx\\\\&=2\\tan x+C\\end{aligned}$$","criteria":[[2,"Correct answer"]],"meta":{"top_criterion_original":"correct primitive (no breakdown given)"}}]},"1417":{"stem":null,"options":[],"opt_table":null,"layout":null,"figures":[],"parts":[{"id":1972,"latex":"Find the primitive function of $\\sec^2(5x)-\\sin(x)+5^x$.","needs_review":0,"c17":{"code":"MA-C4.1","conf":0.9},"note":null,"src_label":"c","can_use":[]}],"solutions":[{"id":1733,"part_id":1972,"source":"extracted","latex":"Integrating term by term:\n$$\\begin{aligned}&\\int\\left(\\sec^2(5x)-\\sin x+5^x\\right)dx\\\\ &=\\dfrac{1}{5}\\tan 5x+\\cos x+\\dfrac{5^x}{\\ln 5}+C\\end{aligned}$$","criteria":[[3,"Correct answer"],[2,"Two of the three terms correct, or equivalent merit"],[1,"One of the three terms correct, or equivalent merit"]],"meta":{"top_criterion_original":"$\\dfrac{5^x}{\\ln 5}$","marker_note":"1 mark each for $\\dfrac{1}{5}\\tan 5x$, $\\cos x$ and $\\dfrac{5^x}{\\ln 5}$."}}]},"1205":{"stem":null,"options":[],"opt_table":null,"layout":null,"figures":[],"parts":[{"id":2038,"latex":"Find $\\displaystyle\\int \\sin\\left(\\dfrac{x}{2}\\right)dx$.","needs_review":0,"c17":{"code":"MA-C4.1","conf":0.8},"note":null,"can_use":[]}],"solutions":[{"id":1788,"part_id":null,"source":"extracted","latex":"$$\\begin{aligned} \\int\\sin\\left(\\dfrac{x}{2}\\right)dx &= 2\\int\\dfrac{1}{2}\\sin\\left(\\dfrac{x}{2}\\right)dx \\\\ &= -2\\cos\\left(\\dfrac{x}{2}\\right)+C \\end{aligned}$$","criteria":[[2,"Correct answer"],[1,"Uses the reverse chain rule, or equivalent merit"]],"meta":{"top_criterion_original":"Correct integral including $+C$","marker_note":"The answer must include $+C$."}}]},"1250":{"stem":"Calculate the following definite integrals. Leave your answers in exact form where necessary.","options":[],"opt_table":null,"layout":null,"figures":[],"parts":[{"id":2113,"latex":"$\\displaystyle\\int_{-2}^{0} \\dfrac{6}{x+3}\\,dx$","needs_review":0,"c17":{"code":"MA-C4.1","conf":0.85},"note":null,"can_use":[]},{"id":2114,"latex":"$\\displaystyle\\int_{\\frac{\\pi}{4}}^{\\frac{\\pi}{3}} \\sec^2 3x\\,dx$","needs_review":0,"c17":{"code":"MA-C4.1","conf":0.75},"note":null,"can_use":[]}],"solutions":[{"id":1863,"part_id":2113,"source":"extracted","latex":"Using $\\displaystyle\\int\\dfrac{1}{x+a}\\,dx=\\ln|x+a|+c$:\n$$\\begin{aligned}\\int_{-2}^{0}\\dfrac{6}{x+3}\\,dx&=6\\int_{-2}^{0}\\dfrac{1}{x+3}\\,dx\\\\&=\\Big[6\\ln|x+3|\\Big]_{-2}^{0}\\\\&=6\\ln|0+3|-6\\ln|(-2)+3|\\\\&=6\\ln3-6\\ln1\\\\&=6\\ln3\\end{aligned}$$","criteria":[[2,"Correct answer"],[1,"Correctly integrates the function, or equivalent merit"]],"meta":{"top_criterion_original":"Provides correct solution"}},{"id":1864,"part_id":2114,"source":"extracted","latex":"Using $\\displaystyle\\int\\sec^2 ax\\,dx=\\dfrac{1}{a}\\tan ax+c$:\n$$\\begin{aligned}\\int_{\\frac{\\pi}{4}}^{\\frac{\\pi}{3}}\\sec^2 3x\\,dx&=\\left[\\dfrac{1}{3}\\tan3x\\right]_{\\frac{\\pi}{4}}^{\\frac{\\pi}{3}}\\\\&=\\dfrac{1}{3}\\tan\\left(3\\times\\dfrac{\\pi}{3}\\right)-\\dfrac{1}{3}\\tan\\left(3\\times\\dfrac{\\pi}{4}\\right)\\\\&=\\dfrac{1}{3}\\times0-\\dfrac{1}{3}\\times(-1)\\\\&=\\dfrac{1}{3}\\end{aligned}$$","criteria":[[2,"Correct answer"],[1,"Correctly integrates the function, or equivalent merit"]],"meta":{"top_criterion_original":"Provides correct solution"}}]},"1358":{"stem":null,"options":[],"opt_table":null,"layout":null,"figures":[],"parts":[{"id":2292,"latex":"Find the derivative of $y = \\tan(x^2)$.","needs_review":0,"c17":{"code":"MA-C2.1","conf":0.85},"note":null,"can_use":[]},{"id":2293,"latex":"Hence, or otherwise, find $\\displaystyle\\int x\\tan^2(x^2)\\,dx$.","needs_review":0,"c17":{"code":"MA-C4.1","conf":0.7},"note":null,"can_use":["Integration using a given derivative"],"gates":{"Integrals of trigonometric functions":{"decision":"keep","evidence":"1/2 int (2x sec^2(x^2) - 2x) dx = 1/2(tan(x^2) - x^2) + C","reason":""}}}],"solutions":[{"id":2042,"part_id":2292,"source":"extracted","latex":"$$y'=2x\\sec^2(x^2)$$","criteria":[[1,"Correct answer"]],"meta":{}},{"id":2043,"part_id":2293,"source":"extracted","latex":"Using $\\tan^2\\theta=\\sec^2\\theta-1$, and part (a) for the primitive of $2x\\sec^2(x^2)$:\n$$\\begin{aligned}\\int x\\tan^2(x^2)\\,dx&=\\int x\\big(\\sec^2(x^2)-1\\big)\\,dx\\\\ &=\\dfrac{1}{2}\\int 2x\\big(\\sec^2(x^2)-1\\big)\\,dx\\\\ &=\\dfrac{1}{2}\\int \\big(2x\\sec^2(x^2)-2x\\big)\\,dx\\\\ &=\\dfrac{1}{2}\\big(\\tan(x^2)-x^2\\big)+C\\end{aligned}$$","criteria":[[3,"Correct answer"],[2,"Writes the integrand as $\\dfrac{1}{2}\\big(2x\\sec^2(x^2)-2x\\big)$, or equivalent merit"],[1,"Uses $\\tan^2(x^2)=\\sec^2(x^2)-1$, or equivalent merit"]],"meta":{"corrected":"Corrected from source: the second line was written $\\frac{1}{2}\\int 2(x\\sec^2(x^2)-1)\\,dx$; the factor 2 multiplies both terms (next line $2x\\sec^2(x^2)-2x$). Final answer unchanged."}}]},"1693":{"stem":null,"options":[{"label":"A","latex":"$2\\sec x+c$","is_correct":0,"key_source":"extracted","fig":null},{"label":"B","latex":"$4\\tan x\\sec^2 x+c$","is_correct":0,"key_source":"extracted","fig":null},{"label":"C","latex":"$2\\tan x+c$","is_correct":1,"key_source":"extracted","fig":null},{"label":"D","latex":"$2x+2\\sec x+c$","is_correct":0,"key_source":"extracted","fig":null}],"opt_table":null,"layout":"text","figures":[],"parts":[{"id":2747,"latex":"Which of the following is an expression for $\\displaystyle\\int\\left(\\dfrac{1}{1+\\sin x}+\\dfrac{1}{1-\\sin x}\\right)dx$?","needs_review":0,"c17":{"code":"MA-C4.1","conf":0.8},"note":null,"can_use":[]}],"solutions":[{"id":2496,"part_id":null,"source":"generated","latex":"$$\\begin{aligned} \\dfrac{1}{1+\\sin x}+\\dfrac{1}{1-\\sin x}&=\\dfrac{(1-\\sin x)+(1+\\sin x)}{1-\\sin^2x} \\\\ &=\\dfrac{2}{\\cos^2x} \\\\ &=2\\sec^2x \\end{aligned}$$\n$$\\int 2\\sec^2x\\,dx=2\\tan x+c$$","criteria":[[1,"Correct answer"]],"meta":{"top_criterion_original":"C"}}]},"1721":{"stem":null,"options":[{"label":"A","latex":"$sec^2x+c$","is_correct":0,"key_source":"extracted","fig":null},{"label":"B","latex":"$2\\,tan\\,x+c$","is_correct":0,"key_source":"extracted","fig":null},{"label":"C","latex":"$tan\\,x-x+c$","is_correct":1,"key_source":"extracted","fig":null},{"label":"D","latex":"$2\\,tan\\,x-x+c$","is_correct":0,"key_source":"extracted","fig":null}],"opt_table":null,"layout":"text","figures":[],"parts":[{"id":2797,"latex":"Which expression gives $\\int tan^2x\\ \\,dx$ ?","needs_review":0,"c17":{"code":"MA-C4.1","conf":0.7},"note":null,"can_use":[]}],"solutions":[{"id":2546,"part_id":null,"source":"generated","latex":"Use the identity $\\tan^2x=\\sec^2x-1$.\n$$\\begin{aligned} \\int\\tan^2x\\,dx &= \\int(\\sec^2x-1)\\,dx \\\\ &= \\tan x-x+c \\end{aligned}$$\nThis is option C.","criteria":[[1,"Correct answer"]],"meta":{"top_criterion_original":"correct answer (key circled in the bundled solutions)"}}]}}}